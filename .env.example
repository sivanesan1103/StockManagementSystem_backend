# Application
PROJECT_NAME=Convoy Backend Foundation
PROJECT_DESCRIPTION=Backend foundation for Convoy platform
VERSION=0.1.0
API_V1_STR=/api/v1

# Server
HOST=0.0.0.0
PORT=8000

# Security
SECRET_KEY=your-secret-key-here-change-in-production
ACCESS_TOKEN_EXPIRE_MINUTES=10080
ALGORITHM=HS256

# CORS
BACKEND_CORS_ORIGINS=[]

# PostgreSQL Database
POSTGRES_SERVER=localhost
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your-password-here
POSTGRES_DB=convoy
POSTGRES_PORT=5432

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Rate Limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_WINDOW_SECONDS=60

# Environment
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO

# Testing
TESTING=false

# Migrations
AUTO_RUN_MIGRATIONS=false